Subject: [PATCH] Dont send useless entity packets

This patch is Powered by Purpur(https://github.com/PurpurMC/Purpur)

diff --git a/net/minecraft/server/level/ServerEntity.java b/net/minecraft/server/level/ServerEntity.java
index e46f95b19da1c14f240ec6697f22b5e220e0a835..b0c885796c81db431dac28104c86578e4cf4a602 100644
--- a/net/minecraft/server/level/ServerEntity.java
+++ b/net/minecraft/server/level/ServerEntity.java
@@ -190,6 +190,14 @@ public class ServerEntity {
                     packet = this.createMovePacket(position, yRotn, xRotn, shouldSendPosition, shouldSendRotation);
                 }
 
+                // Leaves start - don't send useless entity packets
+                if (org.leavesmc.leaves.LeavesConfig.performance.dontSendUselessEntityPackets && this.isUselessPacket(packet)) {
+                    packet = null;
+                    this.lastSentYRot = yRotn;
+                    this.lastSentXRot = xRotn;
+                }
+                // Leaves end - don't send useless entity packets
+
                 if (this.entity.needsSync || this.trackDelta || this.entity instanceof LivingEntity livingEntity && livingEntity.isFallFlying()) {
                     Vec3 movement = this.entity.getDeltaMovement();
                     double diff = movement.distanceToSqr(this.lastSentMovement);
@@ -310,6 +318,14 @@ public class ServerEntity {
         return false;
     }
 
+    // Leaves start - don't send useless entity packets
+    private boolean isUselessPacket(final @Nullable Packet<?> possibleUselessPacket) {
+        return possibleUselessPacket instanceof ClientboundMoveEntityPacket.Rot packet
+            && packet.getYRot() == 0.0F
+            && packet.getXRot() == 0.0F;
+    }
+    // Leaves end - don't send useless entity packets
+
     private void handleMinecartPosRot(final NewMinecartBehavior newMinecartBehavior, final byte yRotn, final byte xRotn, final boolean shouldSendRotation) {
         this.sendDirtyEntityData();
         if (newMinecartBehavior.lerpSteps.isEmpty()) {
