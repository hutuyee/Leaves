Subject: [PATCH] Reduce chunk loading & lookups

This patch is Powered by Pufferfish(https://github.com/pufferfish-gg/Pufferfish)

diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
index 24b98ba55c76de9d6febd01f3a8280f06a2bb9f7..78c04b339b8b1aa2d1fc05304a1970aa02c92edb 100644
--- a/net/minecraft/world/entity/LivingEntity.java
+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -4540,12 +4540,16 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
         boolean ok = false;
         BlockPos pos = BlockPos.containing(xx, y, zz);
         Level level = this.level();
-        if (level.hasChunkAt(pos)) {
+        // Leaves start - single chunk lookup
+        net.minecraft.world.level.chunk.LevelChunk chunk = org.leavesmc.leaves.LeavesConfig.performance.reduceChuckLoadAndLookup
+            ? level.getChunkIfLoaded(pos)
+            : null;
+        if (org.leavesmc.leaves.LeavesConfig.performance.reduceChuckLoadAndLookup ? chunk != null : level.hasChunkAt(pos)) {
             boolean landed = false;
 
             while (!landed && pos.getY() > level.getMinY()) {
                 BlockPos below = pos.below();
-                BlockState state = level.getBlockState(below);
+                BlockState state = chunk == null ? level.getBlockState(below) : chunk.getBlockState(below); // Leaves - single chunk lookup
                 if (state.blocksMotion()) {
                     landed = true;
                 } else {
