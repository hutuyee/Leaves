From: violetc <58360096+s-yh-china@users.noreply.github.com>
Date: Thu, 20 Jul 2023 17:23:33 +0800
Subject: [PATCH] Avoid Class#isAssignableFrom call in ClassInstanceMultiMap

This patch is Powered by Gale(https://github.com/GaleMC/Gale)

diff --git a/net/minecraft/util/ClassInstanceMultiMap.java b/net/minecraft/util/ClassInstanceMultiMap.java
index 021457d7676356ee9d5c7ba174206ba190adc1eb..3108e0494c635c7513b6b4dc48d0971de4fd80e2 100644
--- a/net/minecraft/util/ClassInstanceMultiMap.java
+++ b/net/minecraft/util/ClassInstanceMultiMap.java
@@ -55,13 +55,27 @@ public class ClassInstanceMultiMap<T> extends AbstractCollection<T> {
     }
 
     public <S> Collection<S> find(final Class<S> index) {
-        if (!this.baseClass.isAssignableFrom(index)) {
-            throw new IllegalArgumentException("Don't know how to search for " + index);
+        // Leaves start - avoid Class#isAssignableFrom call
+        List<T> instances = this.byClass.get(index);
+        if (instances == null) {
+            instances = this.createAllOfType(index);
         }
-
-        List<? extends T> instances = this.byClass.computeIfAbsent(index, k -> this.allInstances.stream().filter(k::isInstance).collect(Util.toMutableList()));
         return (Collection<S>)Collections.unmodifiableCollection(instances);
+        // Leaves end - avoid Class#isAssignableFrom call
+    }
+
+    // Leaves start - avoid Class#isAssignableFrom call
+    private <S> List<T> createAllOfType(final Class<S> type) {
+        List<T> instances = new java.util.ArrayList<>(1);
+        for (T instance : this.allInstances) {
+            if (type.isInstance(instance)) {
+                instances.add(instance);
+            }
+        }
+        this.byClass.put(type, instances);
+        return instances;
     }
+    // Leaves end - avoid Class#isAssignableFrom call
 
     @Override
     public Iterator<T> iterator() {
