Subject: [PATCH] Fix Minecraft 26.2 API compatibility


diff --git a/net/minecraft/server/network/ServerCommonPacketListenerImpl.java b/net/minecraft/server/network/ServerCommonPacketListenerImpl.java
index 81830f6b47e7c8059dff2c7576edb9a79f095983..c62ce458369049858eca7795f12fafbf50965313 100644
--- a/net/minecraft/server/network/ServerCommonPacketListenerImpl.java
+++ b/net/minecraft/server/network/ServerCommonPacketListenerImpl.java
@@ -388,7 +388,7 @@ public abstract class ServerCommonPacketListenerImpl implements ServerCommonPack
         if (org.leavesmc.leaves.LeavesConfig.mics.noChatSign
             && this instanceof ServerGamePacketListenerImpl
             && packet instanceof net.minecraft.network.protocol.game.ClientboundPlayerChatPacket chat) {
-            Component content = chat.unsignedContent().orElseGet(() -> Component.literal(chat.body().content()));
+            Component content = java.util.Objects.requireNonNullElseGet(chat.unsignedContent(), () -> Component.literal(chat.body().content()));
             packetToSend = new net.minecraft.network.protocol.game.ClientboundSystemChatPacket(chat.chatType().decorate(content), false);
         }
         // Leaves end - rebuild ClientboundPlayerChatPacket
