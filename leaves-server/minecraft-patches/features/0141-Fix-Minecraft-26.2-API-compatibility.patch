+                    com.destroystokyo.paper.event.player.PlayerElytraBoostEvent event = new com.destroystokyo.paper.event.player.PlayerElytraBoostEvent((org.bukkit.entity.Player) player.getBukkitEntity(), itemStack.asBukkitMirror(), (org.bukkit.entity.Firework) firework.getBukkitEntity(), org.bukkit.craftbukkit.CraftEquipmentSlot.getHand(hand));
                     if (event.callEvent() && org.leavesmc.leaves.util.ElytraAeronauticsHelper.proxySpawnAndTick(firework)) {
                         player.awardStat(Stats.ITEM_USED.get(this));
                         if (!org.leavesmc.leaves.LeavesConfig.modify.oldMC.keepLeashConnectWhenUseFirework && player.dropAllLeashConnections(player, hand)) { // Leaves - keep leash connection when using firework
diff --git a/net/minecraft/world/level/block/entity/HopperBlockEntity.java b/net/minecraft/world/level/block/entity/HopperBlockEntity.java
index 7c3f0acec2732a0cfe2039b4123220572ba129dc..950645448bc70deee24808e7b62d44f4de37709c 100644
--- a/net/minecraft/world/level/block/entity/HopperBlockEntity.java
+++ b/net/minecraft/world/level/block/entity/HopperBlockEntity.java
@@ -988,10 +988,6 @@ public class HopperBlockEntity extends RandomizableContainerBlockEntity implemen
         if (this.cooldownTime > 0 || this.getLevel() == null || skipNextSleepCheckAfterCooldown) {
             return;
         }
-        // PrepareHopperTransferEvent can change the allowed slots without changing either inventory.
-        if (hasPrepareTransferListeners(this.getLevel())) {
-            return;
-        }
         if (isSleeping()) {
             return;
         }
@@ -1580,7 +1576,7 @@ public class HopperBlockEntity extends RandomizableContainerBlockEntity implemen
         }
 
         LithiumStackList hopperStackList = InventoryHelper.getLithiumStackList(hopperBlockEntity);
-        if (!hasPrepareTransferListeners(world) && hopperBlockEntity.insertInventory == insertInventory && hopperStackList.getModCount() == hopperBlockEntity.myModCountAtLastInsert) {
+        if (hopperBlockEntity.insertInventory == insertInventory && hopperStackList.getModCount() == hopperBlockEntity.myModCountAtLastInsert) {
             if (hopperBlockEntity.insertStackList != null && hopperBlockEntity.insertStackList.getModCount() == hopperBlockEntity.insertStackListModCount) {
 //                ComparatorUpdatePattern.NO_UPDATE.apply(hopperBlockEntity, hopperStackList); //commented because it's a noop, Hoppers do not send useless comparator updates
                 return false;
@@ -1649,7 +1645,7 @@ public class HopperBlockEntity extends RandomizableContainerBlockEntity implemen
         LithiumStackList hopperStackList = InventoryHelper.getLithiumStackList(hopperBlockEntity);
         LithiumStackList fromStackList = hopperBlockEntity.extractStackList;
 
-        if (!hasPrepareTransferListeners(world) && hopperStackList.getModCount() == hopperBlockEntity.myModCountAtLastExtract) {
+        if (hopperStackList.getModCount() == hopperBlockEntity.myModCountAtLastExtract) {
             if (fromStackList.getModCount() == hopperBlockEntity.extractStackListModCount) {
                 if (!(from instanceof ComparatorTracker comparatorTracker) || comparatorTracker.lithium$hasAnyComparatorNearby()) {
                     //noinspection CollectionAddedToSelf
@@ -1697,9 +1693,5 @@ public class HopperBlockEntity extends RandomizableContainerBlockEntity implemen
         }
         return false;
     }
-    private static boolean hasPrepareTransferListeners(Level level) {
-        return !level.paperConfig().hopper.disableMoveEvent
-            && io.papermc.paper.event.inventory.PrepareHopperTransferEvent.getHandlerList().getRegisteredListeners().length != 0;
-    }
     // Leaves end - Lithium Sleeping Block Entity
 }
