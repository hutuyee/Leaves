From: violetc <58360096+s-yh-china@users.noreply.github.com>
Date: Mon, 24 Jul 2023 15:54:18 +0800
Subject: [PATCH] Bow infinity fix


diff --git a/net/minecraft/world/entity/player/Player.java b/net/minecraft/world/entity/player/Player.java
index 9963deb55030995406555436a21dd50f15b1377d..6b9b0435356ba47a3b055685bc9169d315ffa9cb 100644
--- a/net/minecraft/world/entity/player/Player.java
+++ b/net/minecraft/world/entity/player/Player.java
@@ -2102,8 +2102,17 @@ public abstract class Player extends Avatar implements ContainerUser {
             }
         }
 
-        if (anyEventCancelled.booleanValue() && !this.abilities.instabuild && this instanceof final ServerPlayer player) this.resyncUsingItem(player); // Paper - resync if no item matched the Predicate
-        return this.hasInfiniteMaterials() ? new ItemStack(Items.ARROW) : ItemStack.EMPTY;
+        // Leaves start - bow infinity fix
+        if ((org.leavesmc.leaves.LeavesConfig.modify.bowInfinityFix || anyEventCancelled.booleanValue())
+            && !this.abilities.instabuild
+            && this instanceof final ServerPlayer player) {
+            this.resyncUsingItem(player); // Paper - resync if no item matched the Predicate
+        }
+        boolean hasInfiniteArrow = org.leavesmc.leaves.LeavesConfig.modify.bowInfinityFix
+            && this.level() instanceof ServerLevel serverLevel
+            && net.minecraft.world.item.enchantment.EnchantmentHelper.processAmmoUse(serverLevel, heldWeapon, new ItemStack(Items.ARROW), 1) <= 0;
+        return this.hasInfiniteMaterials() || hasInfiniteArrow ? new ItemStack(Items.ARROW) : ItemStack.EMPTY;
+        // Leaves end - bow infinity fix
     }
 
     @Override
