From: violetc <58360096+s-yh-china@users.noreply.github.com>
Date: Sat, 25 Jun 2022 18:04:35 +0800
Subject: [PATCH] Spectator dont get Advancement


diff --git a/net/minecraft/server/PlayerAdvancements.java b/net/minecraft/server/PlayerAdvancements.java
index 6052b1a052118ff44b91a774f473623ebcddc691..ceffa9e06abeaead449f6149ca11bad567db5951 100644
--- a/net/minecraft/server/PlayerAdvancements.java
+++ b/net/minecraft/server/PlayerAdvancements.java
@@ -166,6 +166,12 @@ public class PlayerAdvancements {
     }
 
     public boolean award(final AdvancementHolder holder, final String criterion) {
+        // Leaves start - spectator don't get advancement
+        if (org.leavesmc.leaves.LeavesConfig.modify.spectatorDontGetAdvancement
+            && this.player.gameMode.getGameModeForPlayer() == net.minecraft.world.level.GameType.SPECTATOR) {
+            return false;
+        }
+        // Leaves end - spectator don't get advancement
         // Leaves start - bot can't get advancement
         if (this.player instanceof org.leavesmc.leaves.bot.ServerBot) {
             return false;
