diff --git a/net/minecraft/server/network/ServerCommonPacketListenerImpl.java b/net/minecraft/server/network/ServerCommonPacketListenerImpl.java
index d2585f4362ad3111e0bb23a0f25c7df06e43c210..36b45826b61f4006e5ae4e8766d9a146df7a8e93 100644
--- a/net/minecraft/server/network/ServerCommonPacketListenerImpl.java
+++ b/net/minecraft/server/network/ServerCommonPacketListenerImpl.java
@@ -316,10 +316,26 @@ public abstract class ServerCommonPacketListenerImpl implements ServerCommonPack
     }
 
     public void send(final Packet<?> packet) {
-        this.send(packet, null);
+        Packet<?> packetToSend = packet;
+        // Leaves start - rebuild ClientboundPlayerChatPacket
+        if (org.leavesmc.leaves.LeavesConfig.mics.noChatSign
+            && this instanceof ServerGamePacketListenerImpl
+            && packet instanceof net.minecraft.network.protocol.game.ClientboundPlayerChatPacket chat) {
+            Component content = chat.unsignedContent().orElseGet(() -> Component.literal(chat.body().content()));
+            packetToSend = new net.minecraft.network.protocol.game.ClientboundSystemChatPacket(chat.chatType().decorate(content), false);
+        }
+        // Leaves end - rebuild ClientboundPlayerChatPacket
+        this.send(packetToSend, null);
     }
 
-    public void send(final Packet<?> packet, final @Nullable ChannelFutureListener listener) {
+    public void send(final Packet<?> packet, @Nullable ChannelFutureListener listener) {
+        // Leaves start - no ClientboundPlayerChatHeaderPacket and rebuild ClientboundPlayerChatPacket
+        if (org.leavesmc.leaves.LeavesConfig.mics.noChatSign
+            && packet instanceof net.minecraft.network.protocol.game.ClientboundPlayerChatPacket
+            && listener != null) {
+            listener = null;
+        }
+        // Leaves end - no ClientboundPlayerChatHeaderPacket and rebuild ClientboundPlayerChatPacket
         // CraftBukkit start
         if (packet == null) {
             return;
