From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: violetc <58360096+s-yh-china@users.noreply.github.com>
Date: Wed, 5 Jul 2023 17:42:24 +0800
Subject: [PATCH] Cache ignite odds


diff --git a/net/minecraft/world/level/block/FireBlock.java b/net/minecraft/world/level/block/FireBlock.java
index 132edd0e94456378cc8598c39e20749b3cfb382a..17777282a4d474dfba32fd1d501e7d415d2a38c0 100644
--- a/net/minecraft/world/level/block/FireBlock.java
+++ b/net/minecraft/world/level/block/FireBlock.java
@@ -195,6 +195,7 @@ public class FireBlock extends BaseFireBlock {
                 this.checkBurnOut(level, pos.south(), 300 + extra, random, age, pos);
                 // CraftBukkit end - add source blockPos to burn calls
                 BlockPos.MutableBlockPos testPos = new BlockPos.MutableBlockPos();
+                Object2IntOpenHashMap<BlockPos> blockPositionIgniteCache = new Object2IntOpenHashMap<>(); // Leaves - cache ignite odds
 
                 for (int xx = -1; xx <= 1; xx++) {
                     for (int zz = -1; zz <= 1; zz++) {
@@ -206,7 +207,7 @@ public class FireBlock extends BaseFireBlock {
                                 }
 
                                 testPos.setWithOffset(pos, xx, yy, zz);
-                                int igniteOdds = this.getIgniteOdds(level, testPos);
+                                int igniteOdds = this.getIgniteOdds(level, testPos, org.leavesmc.leaves.LeavesConfig.performance.cacheIgniteOdds ? blockPositionIgniteCache : null); // Leaves - cache ignite odds
                                 if (igniteOdds > 0) {
                                     int odds = (igniteOdds + 40 + level.getDifficulty().getId() * 7) / (age + 30);
                                     if (increasedBurnout) {
@@ -308,7 +309,12 @@ public class FireBlock extends BaseFireBlock {
         return false;
     }
 
+    // Leaves start - cache ignite odds
     private int getIgniteOdds(final LevelReader level, final BlockPos pos) {
+        return this.getIgniteOdds(level, pos, null);
+    }
+
+    private int getIgniteOdds(final LevelReader level, final BlockPos pos, final @org.jetbrains.annotations.Nullable Object2IntOpenHashMap<BlockPos> cache) {
         if (!level.isEmptyBlock(pos)) {
             return 0;
         }
@@ -316,12 +322,20 @@ public class FireBlock extends BaseFireBlock {
         int odds = 0;
 
         for (Direction direction : Direction.values()) {
-            BlockState blockState = level.getBlockState(pos.relative(direction));
-            odds = Math.max(this.getIgniteOdds(blockState), odds);
+            if (cache != null) {
+                odds = Math.max(cache.computeIfAbsent(pos, key -> {
+                    BlockState blockState = level.getBlockState(pos.relative(direction));
+                    return this.getIgniteOdds(blockState);
+                }), odds);
+            } else {
+                BlockState blockState = level.getBlockState(pos.relative(direction));
+                odds = Math.max(this.getIgniteOdds(blockState), odds);
+            }
         }
 
         return odds;
     }
+    // Leaves end - cache ignite odds
 
     @Override
     protected boolean canBurn(final BlockState state) {
