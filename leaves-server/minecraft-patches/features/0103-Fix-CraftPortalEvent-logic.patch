Subject: [PATCH] Fix CraftPortalEvent logic


diff --git a/net/minecraft/world/level/block/EndPortalBlock.java b/net/minecraft/world/level/block/EndPortalBlock.java
index 2d48b70e18547330078e49c8f01f2f39b08d274c..8b1535afb8f82ae3a26a818a7363d040a548f892 100644
--- a/net/minecraft/world/level/block/EndPortalBlock.java
+++ b/net/minecraft/world/level/block/EndPortalBlock.java
@@ -116,10 +116,9 @@ public class EndPortalBlock extends BaseEntityBlock implements Portal {
         }
 
         // CraftBukkit start
-        relatives.removeAll(Relative.ROTATION); // remove relative rotation flags to simplify event mutation
+        // Leaves - keep relative rotation flags
         float absoluteYaw = !fromEnd ? yRot : entity.getYRot() + yRot;
-        float absolutePitch = entity.getXRot() + xRot;
-        org.bukkit.craftbukkit.event.PortalEventResult result = org.bukkit.craftbukkit.event.CraftEventFactory.handlePortalEvents(entity, org.bukkit.craftbukkit.util.CraftLocation.toBukkit(spawnPos, newLevel, absoluteYaw, absolutePitch), org.bukkit.PortalType.ENDER, 0, 0);
+        org.bukkit.craftbukkit.event.PortalEventResult result = org.bukkit.craftbukkit.event.CraftEventFactory.handlePortalEvents(entity, org.bukkit.craftbukkit.util.CraftLocation.toBukkit(spawnPos, newLevel, absoluteYaw, 0.0F), org.bukkit.PortalType.ENDER, 0, 0); // Leaves - fix CraftPortalEvent logic
         if (result == null) {
             return null;
         }
