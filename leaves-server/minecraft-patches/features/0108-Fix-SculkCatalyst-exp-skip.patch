From: violetc <58360096+s-yh-china@users.noreply.github.com>
Date: Sun, 6 Apr 2025 10:42:45 +0800
Subject: [PATCH] Fix SculkCatalyst exp skip


diff --git a/net/minecraft/server/level/ServerPlayer.java b/net/minecraft/server/level/ServerPlayer.java
index 1563b9e3f69e6a28c21a95d0c895fd1bd5d08b19..e540b9b6f3b8b7799a82b6d1dd800f97d494313f 100644
--- a/net/minecraft/server/level/ServerPlayer.java
+++ b/net/minecraft/server/level/ServerPlayer.java
@@ -1213,7 +1213,7 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
         }
 
         // SPIGOT-5478 must be called manually now
-        if (event.shouldDropExperience()) this.dropExperience(this.level(), source.getEntity()); // Paper - tie to event
+        if (this.shouldDropExperience(event.shouldDropExperience(), event.forceUseEventDropStatus())) this.dropExperience(this.level(), source.getEntity()); // Paper - tie to event // Leaves - exp fix
         // we clean the player's inventory after the EntityDeathEvent is called so plugins can get the exact state of the inventory.
         if (!event.getKeepInventory()) {
             // Paper start - PlayerDeathEvent#getItemsToKeep
@@ -1260,6 +1260,12 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
         this.connection.markClientUnloadedAfterDeath();
     }
 
+    // Leaves start - exp fix
+    private boolean shouldDropExperience(final boolean eventResult, final boolean forceUseEvent) {
+        return forceUseEvent ? eventResult : !this.wasExperienceConsumed() && eventResult;
+    }
+    // Leaves end - exp fix
+
     protected void tellNeutralMobsThatIDied() { // Leaves private -> protected
         AABB aabb = new AABB(this.blockPosition()).inflate(32.0, 10.0, 32.0);
         this.level()
diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
index 633c925cb2b301f4c8f294cd013849d0544553d6..9db7bad71c6e765ad841396ab7fe828f3d3ba0ef 100644
--- a/net/minecraft/world/entity/LivingEntity.java
+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -296,6 +296,7 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
     public @Nullable Vec3 currentImpulseImpactPos;
     // CraftBukkit start
     public int expToDrop;
+    public int expToReward; // Leaves - exp fix
     public @Nullable List<DefaultDrop> deathDropItems = null;
     public final org.bukkit.craftbukkit.attribute.CraftAttributeMap craftAttributes;
     public boolean collides = true;
@@ -1935,7 +1936,13 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
         }
 
         this.dropEquipment(level);
-        this.postDeathEventTasks.add(() -> this.dropExperience(level, source.getEntity())); // Paper
+        // Leaves start - exp fix; this task runs after ENTITY_DIE lets catalysts consume the experience
+        this.postDeathEventTasks.add(() -> {
+            if (!this.wasExperienceConsumed()) {
+                this.dropExperience(level, source.getEntity());
+            }
+        });
+        // Leaves end - exp fix
     }
 
     protected void dropEquipment(final ServerLevel level) {
