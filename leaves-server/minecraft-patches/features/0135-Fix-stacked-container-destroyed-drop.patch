@@ -43,6 +43,19 @@ public class ItemUtils {
     }
 
     public static void onContainerDestroyed(final ItemEntity container, final Stream<ItemStack> contents) {
+        // Leaves start - fix stacked container destroyed drop
+        if (org.leavesmc.leaves.LeavesConfig.fix.stackedContainerDestroyedDrop) {
+            java.util.List<ItemStack> storedContents = contents.toList();
+            for (int i = 0; i < container.getItem().getCount(); i++) {
+                createDroppedItem(container, storedContents.stream().map(ItemStack::copy));
+            }
+        } else {
+            createDroppedItem(container, contents);
+        }
+    }
+
