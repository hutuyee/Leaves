diff --git a/net/minecraft/world/item/ItemUtils.java b/net/minecraft/world/item/ItemUtils.java
index cc266f88ea6d02e4bc1bb4299d83710559b0c535..b4e28e576a975c8c721e87b76e043d07310f0cb2 100644
