Subject: [PATCH] Check frozen ticks before landing block

This patch is Powered by Gale(https://github.com/GaleMC/Gale)

diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
index a908d868a3fdbc13e5c3b4b311a7cfb3726c4ee7..6f3f06b29dc1de936fedb4fa4547ae8e3dca295a 100644
--- a/net/minecraft/world/entity/LivingEntity.java
+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -567,18 +567,25 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
     }
 
     protected void tryAddFrost() {
-        if (!this.getBlockStateOnLegacy().isAir()) {
-            int ticksFrozen = this.getTicksFrozen();
-            if (ticksFrozen > 0) {
-                AttributeInstance speed = this.getAttribute(Attributes.MOVEMENT_SPEED);
-                if (speed == null) {
-                    return;
-                }
-
-                float slowAmount = -0.05F * this.getPercentFrozen();
-                speed.addTransientModifier(new AttributeModifier(SPEED_MODIFIER_POWDER_SNOW_ID, slowAmount, AttributeModifier.Operation.ADD_VALUE));
+        // Leaves start - check frozen ticks before landing block
+        boolean checkFrozenFirst = org.leavesmc.leaves.LeavesConfig.performance.checkFrozenTicksBeforeLandingBlock;
+        int ticksFrozen = checkFrozenFirst ? this.getTicksFrozen() : 0;
+        if (checkFrozenFirst && ticksFrozen <= 0 || this.getBlockStateOnLegacy().isAir()) {
+            return;
+        }
+        if (!checkFrozenFirst) {
+            ticksFrozen = this.getTicksFrozen();
+        }
+        if (ticksFrozen > 0) {
+            AttributeInstance speed = this.getAttribute(Attributes.MOVEMENT_SPEED);
+            if (speed == null) {
+                return;
             }
+
+            float slowAmount = -0.05F * this.getPercentFrozen();
+            speed.addTransientModifier(new AttributeModifier(SPEED_MODIFIER_POWDER_SNOW_ID, slowAmount, AttributeModifier.Operation.ADD_VALUE));
         }
+        // Leaves end - check frozen ticks before landing block
     }
 
     protected void onChangedBlock(final ServerLevel level, final BlockPos pos) {
