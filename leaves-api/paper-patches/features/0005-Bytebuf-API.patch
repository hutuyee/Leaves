diff --git a/src/main/java/org/bukkit/Bukkit.java b/src/main/java/org/bukkit/Bukkit.java
index a004984544499b200551d1bf8fa3af4b2653df09..0be7e9a6e7c72fbbb9b507ddbfde4a997fd2d886 100644
