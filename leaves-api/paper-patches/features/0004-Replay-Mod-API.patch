diff --git a/src/main/java/org/bukkit/Bukkit.java b/src/main/java/org/bukkit/Bukkit.java
index 57d2ede0d3692b9ed6cd27a29e4e6f9dc1c8a612..66fe601d21ece91de0264deb227014e369f65eaa 100644
