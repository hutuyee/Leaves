diff --git a/src/main/java/org/bukkit/Bukkit.java b/src/main/java/org/bukkit/Bukkit.java
index 70341319ef4727fffd598d2792cb8aa73c3aafea..57d2ede0d3692b9ed6cd27a29e4e6f9dc1c8a612 100644
