diff --git a/src/main/java/org/bukkit/Bukkit.java b/src/main/java/org/bukkit/Bukkit.java
index 823a75649fb2f7081ef649f45cb665b39ee71ffd..6997c8cf4b963013e679eda23d99891941ed56ec 100644
